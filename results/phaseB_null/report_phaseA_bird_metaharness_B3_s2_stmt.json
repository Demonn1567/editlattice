     "start": 43,
     "end": 44,
     "replacement": [
      "    sql = extract_sql(reply)\n",
      "    \n",
      "    # Properly quote string values in WHERE clauses\n",
      "    def quote_value(value):\n",
      "        if isinstance(value, str):\n",
      "            return f\"'{value}'\"\n",
      "        return value\n",
      "    \n",
      "    # Replace values in WHERE clauses with quoted values\n",
      "    import re\n",
      "    where_pattern = re.compile(r'WHERE\\s+([^=]+)=([^ ]+)')\n",
      "    def replace_where(match):\n",
      "        key = match.group(1)\n",
      "        value = match.group(2)\n",
      "        return f\"WHERE {key}={quote_value(value)}\"\n",
      "    \n",
      "    sql = where_pattern.sub(replace_where, sql)\n",
      "    \n",
      "    return {\"answer\": sql}\n"
     ]
    }
   ]
  }

     "start": 13,
     "end": 16,
     "replacement": [
      "    \"\"\"Extract numeric answer from boxed notation or 'Answer:' line, or any number in text.\"\"\"\n",
      "    # Check for boxed answer first\n",
      "    match = re.search(r'\\$\\$\\\\boxed{([^}]*)}\\$\\$', reply)\n",
      "    if match:\n",
      "        return match.group(1).strip()\n",
      "    # Then check for Answer: line\n",
      "    answer_part = reply.rsplit(\"Answer:\", 1)[-1].strip()\n",
      "    # Try to find a number in answer_part (allowing commas in numbers)\n",
      "    match = re.search(r'[-+]?(?:\\d{1,3},?)+\\d*\\.?\\d*|\\d+', answer_part)\n",
      "    if match:\n",
      "        return match.group()\n",
      "    # If no Answer: line, search the entire reply (allowing commas in numbers)\n",
      "    match = re.search(r'[-+]?(?:\\d{1,3},?)+\\d*\\.?\\d*|\\d+', reply)\n",
      "    if match:\n",
      "        return match.group()\n",
      "    # If no number found, return original reply\n"
     ]
    }
   ]

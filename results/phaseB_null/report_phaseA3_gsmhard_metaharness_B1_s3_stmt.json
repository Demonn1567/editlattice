      "    # Check for LaTeX boxed answers (e.g., $$\\boxed{26}$$)\n",
      "    latex_match = re.search(r'\\$\\$\\\\boxed{([^}]*)}\\$\\$', reply)\n",
      "    if latex_match:\n",
      "        return latex_match.group(1).strip()\n",
      "    \n",
      "    # Fallback to \"Answer: ...\" format (case-insensitive)\n",
      "    answer_match = re.search(r'answer:\\s*([^\\n]*)', reply, re.IGNORECASE)\n",
      "    if answer_match:\n",
      "        answer_text = answer_match.group(1).strip()\n",
      "        # Check if answer_text is a valid numeric expression (allowing commas)\n",
      "        if re.fullmatch(r'[+-]?(\\d{1,3}(?:,\\d{3})*\\.?\\d*|\\.\\d+)', answer_text):\n",
      "            return answer_text\n",
      "    \n",
      "    # Fallback to standalone number at end of reply (allowing commas)\n",
      "    match = re.search(r'([+-]?(\\d{1,3}(?:,\\d{3})*\\.?\\d*|\\.\\d+))$', reply)\n",
      "    if match:\n",
      "        return match.group(1).strip()\n",
      "    \n"
     ]

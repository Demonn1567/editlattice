      "    # Check for LaTeX boxed answers like $$\\boxed{...}$$\n",
      "    import re\n",
      "    match = re.search(r'\\$\\$(?:\\s*boxed\\s*{([^}]*)}\\s*)\\$\\$', reply)\n",
      "    if match:\n",
      "        return match.group(1).strip()\n",
      "    # Fallback to last line if it looks like a number (including decimals)\n",
      "    lines = reply.strip().split('\\n')\n",
      "    last_line = lines[-1].strip()\n",
      "    if re.fullmatch(r'[-+]?\\d*\\.?\\d+', last_line):\n",
      "        return last_line\n"
     ]
    }
   ]

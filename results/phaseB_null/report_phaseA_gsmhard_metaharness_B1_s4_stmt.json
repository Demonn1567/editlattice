     "replacement": [
      "    \"\"\"Extract the final answer using a regular expression, handling both formatted and unformatted answers.\"\"\"\n",
      "    import re\n",
      "    # Try to match answer with \"Answer:\" prefix\n",
      "    match = re.search(r'Answer:\\s*(\\d+\\.?\\d*)', reply)\n",
      "    if match:\n",
      "        return match.group(1)\n",
      "    # Try to match answer at the end of the response\n",
      "    match = re.search(r'\\s*(\\d+\\.?\\d*)$', reply)\n",
      "    if match:\n",
      "        return match.group(1)\n",
      "    # Check for answer on a new line\n",
      "    if reply.endswith('\\n'):\n",
      "        return reply.split('\\n')[-1].strip()\n",
      "    return reply.strip()\n",
      "    if match:\n",
      "        return match.group(1)\n"
     ]
    }
   ]
